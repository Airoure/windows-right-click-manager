{
  "name": "windows-right-click-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "check": "tsc -b",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "format": "prettier --write src vite.config.ts package.json tsconfig.json index.html",
    "format:check": "prettier --check src vite.config.ts package.json tsconfig.json index.html"
  },
  "dependencies": {
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-dialog": "2.7.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  }
}
